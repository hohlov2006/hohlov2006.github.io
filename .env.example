# Скопируйте этот файл в .env (локально) или задайте те же переменные в панели хостинга.
PORT=3000

# --- Доступ в режим разработчика ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=придумайте-свой-пароль
# Секрет для подписи сессий (любая длинная случайная строка). Если не задан — генерируется при каждом запуске.
SESSION_SECRET=

# --- ИИ (любой OpenAI-совместимый API). Если AI_API_KEY пуст — работает встроенный генератор ---
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=20000

# --- Прочее ---
# Папка для файла базы данных
DATA_DIR=./data
# 1 = при пустой базе заполнить демо-данными (удобно на бесплатном хостинге, где диск временный)
AUTO_SEED=1
